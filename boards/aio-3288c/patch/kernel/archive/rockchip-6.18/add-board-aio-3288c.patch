+		};
+	};
+
+	sdmmc {
+		sdmmc_pwr: sdmmc-pwr {
+			rockchip,pins = <7 11 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	usb_host {
+		host_vbus_drv: host-vbus-drv {
+			rockchip,pins = <0 14 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+		usbhub_rst: usbhub-rst {
+			rockchip,pins = <8 3 RK_FUNC_GPIO &pcfg_output_high>;
+		};
+	};
+
+	usb_otg {
+		otg_vbus_drv: otg-vbus-drv {
+			rockchip,pins = <0 12 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	wk2xxx {
+		/* CS (GPIO5_B5 = gpio5_13) stays muxed as a plain GPIO because it
+		 * is used as the SPI controller-level cs-gpios (see &spi0);
+		 * power/reset/irq remain plain GPIOs. */
+		wk2xxx_gpios: wk2xxx-gpios {
+			rockchip,pins =
+				<5 RK_PB5 RK_FUNC_GPIO &pcfg_pull_up>,
+				<3 RK_PB6 RK_FUNC_GPIO &pcfg_pull_none>,
+				<0 RK_PC2 RK_FUNC_GPIO &pcfg_pull_none>,
+				<0 RK_PA7 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+	};
+
+	i2s0 {
+		/* I2S0_MCLK = GPIO7_C7 func 1, not present in mainline dtsi */
+		i2s0_mclk: i2s0-mclk {
+			rockchip,pins = <7 15 1 &pcfg_pull_none>;
+		};
+	};
+};
