# Radxa Rock 5 ITX (RK3588) — vendor BSP 内核 + X11 硬解桌面 (trixie / xfce)
# 板卡描述文件是本仓导入的上游副本: config/boards/rock-5-itx.conf (BOARD 与文件名一致)
#
# 硬件事实（无线模组）: Radxa Wireless Module A8 = Realtek RTL8852BE，M.2 2230 E-Key。
#   Wi-Fi 走 PCIe（rtw88_8852be）、蓝牙走 USB（btusb + rtl_bt 固件）→ 本板**没有 BT_UART**，
#   不要照搬 am60-sa12 / h96s 的 UART 蓝牙路子。驱动与固件是否在镜像里，由
#   post_family_tweaks__rock5itx_wireless_check 在构建期自检并写进日志。
#   固件由 armbian-firmware 提供（上游默认装**精简版**）；若构建日志里自检报缺 blob，
#   在本文件加 BOARD_FIRMWARE_INSTALL="-full" 换 armbian-firmware-full，别等烧卡后 apt 补。
BOARD=rock-5-itx
BRANCH=vendor
RELEASE=trixie
BUILD_DESKTOP=yes
BUILD_MINIMAL=no
# 桌面必须显式指定, 否则 armbian 会弹 dialog 选桌面/档位 (CI 无 TTY 直接退 43)
# xfce 是 X11 会话 → rkmpp 零拷贝基线; 档位合法值只有 minimal|mid|full (没有 base)
DESKTOP_ENVIRONMENT=xfce
DESKTOP_TIER=mid
# 板级开机定制写在 config/boards/rock-5-itx.conf 的 post_family_tweaks__rock5itx_* 里。
#
# 扩展（各扩展自己按 RELEASE/BRANCH/桌面判定）:
#   chromium-rkmpp     —— 网页视频硬解，只对 jammy|noble 生效；本板默认 trixie → 自动跳过
#                        （Debian 侧 chromium 无 V4L2 VDA patch，是死路）。写在这是为了
#                        CI 里把 RELEASE 切成 noble 时不用改 build.env。
#   rk35xx-chinese-desktop —— 中文 locale/字体/fcitx5-rime/Chromium 中文 + DTB 过滤。
#   dtb-no-mac         —— 去掉 vendor DTB 写死的 MAC。
#   ntp-boot-sync      —— 每次开机强制校时（RTC 电池没装时时间会退回构建日期 → TLS 全挂）。
#   bluetooth-autoconnect —— 开机自动回连已配对的蓝牙音频（本板 = A8 模组的 RTL8852BE BT，走 USB）；
#                        只走 BlueZ D-Bus，没有 BT 硬件时守护空转不影响启动。
#   audio-friendly-names —— 声卡按 ID_PATH 起中文名（es8316 → 耳机输出/麦克风输入，hdmi1/dp0/dp1/
#                        hdmiin 各自标出），并补装 libcanberra-pulse：桌面「设置 → 声音 → 测试」
#                        走 libcanberra，只有 ALSA 后端时被 PipeWire 独占声卡挡成静默失败
#                        （2026-11-25 在 lz120 板实测过这个坑）。不改默认出口、不改路由。
# 不写 rkmpp-mpv（2026-11-26）：标准版（build-image.yml）= 纯 armbian 构建，不带播放器硬解栈。
#           build.env 这份列表只喂标准版与 build-all；两个定制版 workflow 各自无条件
#           add_ext rkmpp-mpv（build-wayland.yml:418 / build-x11.yml:405），摘这条不影响它们
#           ——要 mpv 本地硬解（CMA=512M、强制 X11、mpv.conf hwdec=rkmpp）请走 X11 定制版，
#           trixie 命中预编译 deb（tag rkmpp-stack-v0.41.0-2）→ CI 秒级装，不自编译
#           （自编译在 x86 runner + qemu 下必撞 6h 上限）。
ENABLE_EXTENSIONS=chromium-rkmpp,rk35xx-chinese-desktop,dtb-no-mac,ntp-boot-sync,bluetooth-autoconnect,audio-friendly-names

# Armbian 打镜像时 rsync 默认 --exclude="/home/*"（lib/functions/image/rootfs-to-image.sh:38），
# 会把 default-user 建的家目录丢掉 → 自动登录成功但 $HOME 不存在（187 实测）。显式包含 home。
INCLUDE_HOME_DIR=yes
