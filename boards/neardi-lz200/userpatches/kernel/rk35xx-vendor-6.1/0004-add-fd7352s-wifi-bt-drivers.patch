+#define SKW_BSS_TYPE_IBSS                             WLAN_CAPABILITY_IBSS
+#define SKW_PRIVACY_ESS_ANY                           WLAN_CAPABILITY_ESS
+#define SKW_PRIVACY_IBSS_ANY                          WLAN_CAPABILITY_ESS
