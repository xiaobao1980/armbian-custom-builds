// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * H96 Max M9 (RK3576) board device tree — vendor 6.1.141 (Armbian "vendor_6.1.115")
 *
 * Target kernel: Rockchip SDK linux-6.1.141 (rk-linux6.1-2026060914)
 *   -> Armbian branch: rk3576 / rockchip64 vendor, KVER ~6.1.115
 *
 * Derived from:
 *   - /Volumes/share/H96s/Android提取/android-.dts   (running Android 14, kernel 6.1.75)
 *   - SDK ref board: arch/arm64/boot/dts/rockchip/rk3576-evb1.dtsi
 *
 * Pin map below is taken from the RUNNING Android system (gpio-status.txt), which is
 * authoritative — the decompiled android-.dts had copy/paste errors we fix here.
 *
 * !! KNOWN HARDWARE CONFLICTS RESOLVED HERE (verify on your board):
 *   1) gpio0_25 (RK_PD1) is driven by BOTH "work-green" LED and a usb_otg0_pwren pinctrl
 *      in the Android DTS. The running system only exposes it as "work-green" — there is NO
 *      OTG-5V regulator on this pin. => We give gpio0_25 to the LED and DO NOT put a GPIO
 *      regulator on it for OTG. If your OTG port needs 5V, it is likely self/bus-powered.
 *   2) hp-det-gpio in android-.dts was set to gpio0_27 (RK_PD3) — the SAME pin as the power
 *      key. That is a vendor copy bug. We DROP hp-det-gpio and the hp_det pinctrl to avoid a
 *      gpio-keys vs audio driver clash; find the real headphone-detect pin from the schematic
 *      if you need jack detection.
 *   3) gpio1_22 (RK_PC6) is shared by "pwr-wifi" LED and the WiFi power-enable
 *      (wifi_poweren_gpio). We let the sdio_pwrseq own the pin and DROP the pwr-wifi LED.
 *
 * WiFi/BT:
 *   Module = AIC8800DC (SDIO id 0x390b, confirmed from dmesg + shield marking "L8800D").
 *   The in-kernel driver is OUT-OF-TREE (drivers/net/wireless/aic8800 from the 6.1.75
 *   Android vendor, ported to 6.1.141). The wlan-platdata / bluetooth-platdata nodes below
 *   ARE consumed by net/rfkill/rfkill-wlan.c and rfkill-bt.c which still exist in 6.1.141.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include "rk3576.dtsi"

/ {
	model = "H96 Max M9";
	compatible = "rockchip,rk3576-h96-m9s", "rockchip,rk3576";

	aliases {
		ethernet0 = &gmac0;
	};

	chosen {
		stdout-path = "serial2:1500000n8";
	};

	/* ---------- board fixed regulators (verified from running Android) ---------- */
	vcc5v0_host: vcc5v0-host {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_host";
		regulator-boot-on;
		regulator-always-on;
		enable-active-high;
		gpio = <&gpio0 RK_PB7 GPIO_ACTIVE_HIGH>;		/* gpio0_23 */
		pinctrl-names = "default";
		pinctrl-0 = <&usb_host_pwren>;
		vin-supply = <&vcc5v0_device>;
	};

	vcc3v3_lcd0_n: vcc3v3-lcd0-n {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_lcd0_n";
		regulator-boot-on;
		enable-active-high;
		gpio = <&gpio0 RK_PC6 GPIO_ACTIVE_HIGH>;		/* gpio0_22 */
		pinctrl-names = "default";
		pinctrl-0 = <&lcd_pwren>;
		vin-supply = <&vcc_3v3_s0>;
	};

	vcc5v0_device: vcc5v0-device {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_device";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc_sys>;
	};

	vcc_sys: vcc-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc_sys";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc12v_dcin>;
	};

	vcc12v_dcin: vcc12v-dcin {
		compatible = "regulator-fixed";
		regulator-name = "vcc12v_dcin";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
	};

	/* 3.3V system rail (normally supplied by the RK806 PMIC dtsi; defined here so the
	 * board DTS is self-contained without pulling in a PMIC dtsi). */
	vcc_3v3_s0: vcc-3v3-s0 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3_s0";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_sys>;
	};

	/* SDIO power-on sequence for AIC8800
	 * power-enable on gpio1_22, reset on gpio0_26 (active LOW, confirmed from android DTS) */
	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_poweren_gpio>;			/* gpio1_22 = pwr-wifi */
		post-power-on-delay-ms = <200>;
		reset-gpios = <&gpio0 RK_PD2 GPIO_ACTIVE_LOW>;	/* gpio0_26, reset low-active */
		status = "okay";
	};

	/* ---------- power + adc keys ---------- */
	gpio_keys: gpio-keys {
		compatible = "gpio-keys";
		autorepeat;

		power: power-key {
			debounce-interval = <100>;
			gpios = <&gpio0 RK_PD3 GPIO_ACTIVE_LOW>;	/* gpio0_27 */
			label = "GPIO Key Power";
			linux,code = <KEY_POWER>;
			wakeup-source;
		};
	};

	adc_keys: adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 1>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <100>;

		vol-up-key {
			label = "volume up";
			linux,code = <KEY_VOLUMEUP>;
			press-threshold-microvolt = <170000>;
		};
		vol-down-key {
			label = "volume down";
			linux,code = <KEY_VOLUMEDOWN>;
			press-threshold-microvolt = <417000>;
		};
		menu-key {
			label = "menu";
			linux,code = <KEY_MENU>;
			press-threshold-microvolt = <890000>;
		};
		back-key {
			label = "back";
			linux,code = <KEY_BACK>;
			press-threshold-microvolt = <1236000>;
		};
	};

	/* ---------- LEDs (active-low GPIOs) ---------- */
	leds: leds {
		compatible = "gpio-leds";

		work-green {
			gpios = <&gpio0 RK_PD1 GPIO_ACTIVE_LOW>;	/* gpio0_25 */
			color = <LED_COLOR_ID_GREEN>;
			linux,default-trigger = "default-on";
		};
		work-red {
			gpios = <&gpio0 RK_PD0 GPIO_ACTIVE_LOW>;	/* gpio0_24 */
			color = <LED_COLOR_ID_RED>;
			linux,default-trigger = "none";
			default-state = "off";
		};
		/* pwr-wifi LED intentionally omitted: gpio1_22 is owned by sdio_pwrseq */
	};

	/* ---------- ES8388 analog audio (vendor multicodecs-card) ---------- */
	es8388_sound: es8388-sound {
		status = "okay";
		compatible = "rockchip,multicodecs-card";
		rockchip,card-name = "rockchip-es8388";
		/* hp-det-gpio intentionally removed: android-.dts wrongly shared gpio0_27 (power key) */
		io-channels = <&saradc 3>;
		io-channel-names = "adc-detect";
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <100>;
		spk-con-gpio = <&gpio2 RK_PB1 GPIO_ACTIVE_HIGH>;	/* gpio2_9 (phandle 0xe3 in android) */
		hp-con-gpio = <&gpio3 RK_PD6 GPIO_ACTIVE_HIGH>;	/* gpio3_30 (phandle 0x109 in android) */
		rockchip,pre-power-on-delay-ms = <30>;
		rockchip,post-power-down-delay-ms = <40>;
		rockchip,format = "i2s";
		rockchip,mclk-fs = <256>;
		rockchip,cpu = <&sai1>;
		rockchip,codec = <&es8388>;
		rockchip,audio-routing =
			"Headphone", "LOUT1",
			"Headphone", "ROUT1",
			"Speaker", "LOUT2",
			"Speaker", "ROUT2",
			"Headphone", "Headphone Power",
			"Headphone", "Headphone Power",
			"Speaker", "Speaker Power",
			"Speaker", "Speaker Power",
			"LINPUT1", "Main Mic",
			"LINPUT2", "Main Mic",
			"RINPUT1", "Headset Mic",
			"RINPUT2", "Headset Mic";

		play-pause-key {
			label = "playpause";
			linux,code = <KEY_PLAYPAUSE>;
			press-threshold-microvolt = <2000>;
		};
	};

	/* ---------- HDMI audio (RK internal HDMI, vendor sai0 path) ----------
	 * NOTE: Android used i2s0_8ch + ht5010 dummy-codec, but vendor 6.1.141 renames the I2S
	 * controllers to sai0..sai9, so we bind to &sai0 and &hdmi here. */
	hdmi_sound: hdmi-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "rockchip-hdmi";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;
		status = "okay";

		simple-audio-card,cpu {
			sound-dai = <&sai0>;
		};
		simple-audio-card,codec {
			sound-dai = <&hdmi>;
		};
	};

	/* ---------- WiFi (AIC8800) platform data ----------
	 * consumed by net/rfkill/rfkill-wlan.c (present in 6.1.141). The real WiFi driver is the
	 * out-of-tree aicwf_sdio.ko built against this tree. wlan-platdata supplies the host-wake
	 * IRQ gpio. wifi_chip_type is passed through to the aic driver as a string. */
	wireless_wlan: wireless-wlan {
		compatible = "wlan-platdata";
		wifi_chip_type = "aic8800";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_host_wake_irq>;
		WIFI,host_wake_irq = <&gpio0 RK_PB0 GPIO_ACTIVE_LOW>;	/* gpio0_8 */
		status = "okay";
	};

	/* ---------- Bluetooth (AIC8800) platform data ----------
	 * consumed by net/rfkill/rfkill-bt.c (present in 6.1.141). aicbsp_sdio.ko is out-of-tree. */
	wireless_bluetooth: wireless-bluetooth {
		compatible = "bluetooth-platdata";
		uart_rts_gpios = <&gpio1 RK_PC2 GPIO_ACTIVE_LOW>;		/* gpio1_18 (bt rts) */
		pinctrl-names = "default", "rts_gpio";
		pinctrl-0 = <&uart4_gpios>;
		pinctrl-1 = <&uart4_gpios>;
		BT,reset_gpio = <&gpio1 RK_PC7 GPIO_ACTIVE_LOW>;		/* gpio1_23 */
		BT,wake_gpio = <&gpio1 RK_PD4 GPIO_ACTIVE_LOW>;		/* gpio1_28 */
		BT,wake_host_irq = <&gpio0 RK_PB1 GPIO_ACTIVE_LOW>;	/* gpio0_9 */
		status = "okay";
	};
};

/* ---------- I2C2: hym8563 RTC ---------- */
&i2c2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2m0_xfer>;

	hym8563: rtc@51 {
		compatible = "haoyu,hym8563";
		reg = <0x51>;
		#clock-cells = <0>;
		clock-frequency = <32768>;
		clock-output-names = "hym8563";
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PA0 IRQ_TYPE_LEVEL_LOW>;
		wakeup-source;
	};
};

/* ---------- I2C3: ES8388 codec ---------- */
&i2c3 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3m0_xfer>;

	es8388: es8388@10 {
		status = "okay";
		#sound-dai-cells = <0>;
		compatible = "everest,es8388", "everest,es8323";
		reg = <0x10>;
		clocks = <&mclkout_sai1>;
		clock-names = "mclk";
		assigned-clocks = <&mclkout_sai1>;
		assigned-clock-rates = <12288000>;
		pinctrl-names = "default";
		pinctrl-0 = <&sai1m0_mclk>;
	};
};

/* ---------- SAI1 (ES8388 CPU DAI) ---------- */
&sai1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&sai1m0_lrck
		     &sai1m0_sclk
		     &sai1m0_sdi0
		     &sai1m0_sdo0>;
};

/* ---------- SAI0 (HDMI CPU DAI) ---------- */
&sai0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&sai0m0_lrck
		     &sai0m0_sclk
		     &sai0m0_sdo0
		     &sai0m0_mclk>;
};

/* ---------- UART4: Bluetooth HCI ---------- */
&uart4 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart4m0_xfer &uart4m0_ctsn &uart4m0_rtsn>;
};

/* ---------- SDIO: AIC8800 WiFi ----------
 * NOTE: in rk3576.dtsi the WiFi SDIO controller is labelled "sdio" (mmc@2a320000), NOT sdmmc0.
 * The SD card slot is the separate "sdmmc" controller. */
&sdio {
	max-frequency = <200000000>;
	no-sd;
	no-mmc;
	bus-width = <4>;
	disable-wp;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	mmc-pwrseq = <&sdio_pwrseq>;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc1m0_bus4 &sdmmc1m0_clk &sdmmc1m0_cmd>;
	sd-uhs-sdr104;
	status = "okay";
};

/* SD card slot (if populated on the board) */
&sdmmc {
	status = "okay";
	bus-width = <4>;
	cap-sd-highspeed;
	broken-cd;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd>;
};

/* ---------- USB host (gpio0_23) ---------- */
&usbhost0_0 {
	status = "okay";
};

&usbhost0_1 {
	status = "okay";
};

&usbdrd3_0 {
	status = "okay";
	dr_mode = "otg";
};

/* ---------- HDMI video ---------- */
&hdmi {
	status = "okay";
};

&route_hdmi {
	status = "okay";
	connect = <&vp0_out_hdmi>;
};

/* ---------- board pin control ---------- */
&pinctrl {
	usb {
		usb_host_pwren: usb-host-pwren {
			rockchip,pins = <0 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>;	/* gpio0_23 */
		};

		lcd_pwren: lcd-pwren {
			rockchip,pins = <0 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>;	/* gpio0_22 */
		};
	};

	wireless-wlan {
		wifi_host_wake_irq: wifi-host-wake-irq {
			rockchip,pins = <0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>;	/* gpio0_8 */
		};

		wifi_poweren_gpio: wifi-poweren-gpio {
			rockchip,pins = <1 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up>;	/* gpio1_22 */
		};
	};

	wireless-bluetooth {
		uart4_gpios: uart4-gpios {
			rockchip,pins = <1 RK_PC2 RK_FUNC_GPIO &pcfg_pull_none>;	/* gpio1_18 */
		};
	};
};
