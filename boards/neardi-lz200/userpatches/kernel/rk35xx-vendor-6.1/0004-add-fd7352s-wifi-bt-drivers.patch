+static struct skw_iwpriv_cmd *skw_iwpriv_cmd_match(struct skw_iwpriv_cmd *cmds,
+					const char *key, int key_len)
+{
+	int i;
+
+	for (i = 0; cmds[i].name; i++) {
+		if (!memcmp(cmds[i].name, key, key_len))
+			return &cmds[i];
+	}
+
+	return NULL;
+}
