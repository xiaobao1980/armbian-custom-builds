# Neardi LZ200 (RK3576) — vendor BSP 内核 + 中文 X11 桌面 (trixie / xfce)
# 注意: 板卡配置文件名是 neardi-lz200.csc, BOARD 必须与文件名一致 → neardi-lz200。
# 板级文件来源: /Users/xiaobao/WorkBuddy/armbian/board/neardi/LKD3576/userpatches/
BOARD=neardi-lz200
BRANCH=vendor
RELEASE=trixie
BUILD_DESKTOP=yes
BUILD_MINIMAL=no
# 桌面必须显式指定, 否则 armbian 会弹 dialog 选桌面/档位 (CI 无 TTY 直接挂)
DESKTOP_ENVIRONMENT=xfce
DESKTOP_TIER=mid
# vendor 内核 + X11(xfce) 桌面: 公共扩展
#   chromium-rkmpp —— 网页视频: PPA 的 chromium +rkmpp (仅 jammy|noble)；本板默认 trixie
#     → 扩展自己判不满足、自动跳过 (Debian 侧 chromium 无 VDA patch)。
#   rk35xx-chinese-desktop (common/extensions/rk35xx-chinese-desktop.sh)
#     — 中文桌面通用设置: root密码/首启建用户、locale/时区/中文字体、
#       XFCE(X11)→fcitx5-rime+雾凇拼音、Chromium 中文、DTB 过滤。
#   audio-friendly-names (common/extensions/audio-friendly-names.sh)
#     — 桌面分支只做两件事：按 ID_PATH 给声卡起中文名（es8388 → 耳机输出/麦克风输入、
#       hdmi/dp 各自标出来），以及补装 libcanberra-pulse。后者是修「设置 → 声音 → 测试
#       点了没声」：桌面事件音走 libcanberra，镜像默认只有 ALSA 后端而 PipeWire 独占声卡
#       → 打不开设备且**静默失败**（2026-11-25 在 lz120 板实测）。不改默认出口、不改路由。
# 不写 rkmpp-mpv（2026-11-26）：标准版（build-image.yml）= 纯 armbian 构建，不带播放器硬解栈。
#           build.env 这份列表只喂标准版与 build-all；两个定制版 workflow 各自无条件
#           add_ext rkmpp-mpv（build-wayland.yml:418 / build-x11.yml:405），摘这条不影响它们
#           ——本板本来就是 X11 定制版在吃 mpv 本地硬解（强制 X11、CMA=512M、mpv.conf
#           hwdec=rkmpp、桌面菜单图标，见 common/extensions/rkmpp-mpv.sh）。
#           仍要注意：给本板装硬解栈时 RELEASE 必须 trixie（预编译 deb 钉死 trixie SONAME，
#           如 libplacebo349）；bookworm 的 libplacebo 5.229 < mpv 0.41 需要的 6.338.2，自编译必失败。
ENABLE_EXTENSIONS=chromium-rkmpp,rk35xx-chinese-desktop,dtb-no-mac,audio-friendly-names

# Armbian 打镜像时 rsync 默认 --exclude="/home/*"（lib/functions/image/rootfs-to-image.sh:38），
# 会把 default-user 建的家目录丢掉 → 镜像 /home 为空、$HOME 不存在（187 实测）。
# 显式包含 home，家目录与 /etc/skel 才会随镜像交付。
INCLUDE_HOME_DIR=yes
