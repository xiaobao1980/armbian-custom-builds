+			   WLAN_AUTH_CHALLENGE_LEN) == 0) {
+			status = WLAN_STATUS_SUCCESS;
+			SKW_KFREE(sta->challenge);
+		} else {
+			status = WLAN_STATUS_CHALLENGE_FAIL;
+		}
+
+		break;
+
+	default:
+		status = WLAN_STATUS_UNKNOWN_AUTH_TRANSACTION;
+		break;
+	}
+
+	return status;
+}
+#endif
