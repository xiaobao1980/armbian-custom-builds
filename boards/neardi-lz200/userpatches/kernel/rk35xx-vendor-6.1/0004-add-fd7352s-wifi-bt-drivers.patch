+#define SKW_EDMA_SKB_DATA_LEN            2048
+
+#define SKW_EDMA_WIFI_CMD_CHN            14
+#define SKW_EDMA_WIFI_SHORT_EVENT_CHN    15
+#define SKW_EDMA_WIFI_LONG_EVENT_CHN     16
