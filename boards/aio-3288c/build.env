# AIO-3288C (Firefly, RK3288) 默认构建参数
# KERNEL_TARGET="current,edge"；rockchip-6.18 补丁系列对应 BRANCH=edge
BOARD=aio-3288c
BRANCH=edge
RELEASE=noble
BUILD_DESKTOP=yes
BUILD_MINIMAL=no
# RK3288 是 32 位 (BOARDFAMILY=rockchip → ARCH=armhf), gnome/kde 只支持 arm64/amd64,
# armhf 侧可选: xfce / cinnamon / mate / i3-wm / enlightenment
# 桌面必须显式指定, 否则 armbian 会弹 dialog 选桌面/档位 (CI 无 TTY 直接挂)
DESKTOP_ENVIRONMENT=xfce
DESKTOP_TIER=mid
# 板级内核配置扩展（必须显式启用，userpatches/extensions/*.sh **不会**自动加载）：
#   wk2xxx-aio3288c — 本板专用 CONFIG_SPI_WK2XXX（WK2124 SPI-4UART：板载 RS232×2/RS485），
#     驱动源码由 patch/kernel/archive/rockchip-6.18/add-wk2xxx-driver.patch 提供，
#     Kconfig 里 SPI_WK2XXX 是 tristate 且无 default → 不置 y 就不会编进内核，
#     表现是板上没有任何 ttyWK* 设备（RS232/RS485 全废）。
#   其它符号只在 aio-3288c 上存在，对别的板天然无副作用（其它板不要抄这一行）。
ENABLE_EXTENSIONS=wk2xxx-aio3288c
