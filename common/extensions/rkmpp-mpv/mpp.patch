+    MP_TARRAY_APPEND(p, p->formats, num_formats, IMGFMT_BGR30_YUV);
 #ifdef AV_PIX_FMT_P210
     MP_TARRAY_APPEND(p, p->formats, num_formats, pixfmt2imgfmt(AV_PIX_FMT_P210));
