# Neardi LZ200 (RK3576) — vendor 分支，自定义内核配置 linux-neardi-lz200-rk3576
BOARD=neardi-lz200
BRANCH=vendor
RELEASE=bookworm
BUILD_DESKTOP=yes
BUILD_MINIMAL=no
# 桌面必须显式指定, 否则 armbian 会弹 dialog 选桌面/档位 (CI 无 TTY 直接挂)
DESKTOP_ENVIRONMENT=gnome
DESKTOP_TIER=mid
# vendor 内核: 启用 RKMPP+mpv 硬解扩展, 全局非 Wayland (X11)
ENABLE_EXTENSIONS=rkmpp-mpv
