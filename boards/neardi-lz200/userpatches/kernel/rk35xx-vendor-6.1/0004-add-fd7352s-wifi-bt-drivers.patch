+			s32 rssi_level, gfp_t gfp)
+{
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(4, 11, 0)
+	cfg80211_cqm_rssi_notify(dev, rssi_event, rssi_level, gfp);
+#else
