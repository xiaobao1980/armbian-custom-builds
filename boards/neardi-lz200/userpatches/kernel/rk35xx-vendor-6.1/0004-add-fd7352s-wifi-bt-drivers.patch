+struct skw_skb_rxcb {
+	unsigned long rx_time;
+	u16 rx_desc_offset;
+	u8 amsdu_bitmap;
+	u8 amsdu_mask;
+	u16 amsdu_flags;
+	u8 skw_created;
+	u8 lmac_id;
+	u8 skip_replay_detect;
+};
