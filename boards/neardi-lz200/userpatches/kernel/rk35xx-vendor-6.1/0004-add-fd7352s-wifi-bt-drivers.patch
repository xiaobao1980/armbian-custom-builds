+static void skw_usb_wake_unlock(void)
+{
+	if (!wakelocked)
+		return;
+	wakelocked = 0;
+#ifdef CONFIG_WAKELOCK
+	__pm_relax(&usb_wakelock.ws);
+#else
+	__pm_relax(usb_wakelock);
+#endif
