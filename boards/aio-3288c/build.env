# AIO-3288C (Firefly, RK3288) 默认构建参数
# KERNEL_TARGET="current,edge"；rockchip-6.18 补丁系列对应 BRANCH=edge
BOARD=aio-3288c
BRANCH=edge
RELEASE=noble
BUILD_DESKTOP=yes
BUILD_MINIMAL=no
# RK3288 是 32 位 (BOARDFAMILY=rockchip → ARCH=armhf), gnome/kde 只支持 arm64/amd64,
# armhf 侧可选: xfce / cinnamon / mate / i3-wm / enlightenment
# 桌面必须显式指定, 否则 armbian 会弹 dialog 选桌面/档位 (CI 无 TTY 直接挂)
DESKTOP_ENVIRONMENT=xfce
DESKTOP_TIER=mid
