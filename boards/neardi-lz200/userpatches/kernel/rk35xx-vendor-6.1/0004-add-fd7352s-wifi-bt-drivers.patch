+static inline void
+skw_compat_scan_done(struct cfg80211_scan_request *req, bool aborted)
+{
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(4, 8, 0)
+	struct cfg80211_scan_info info = {
+		.aborted = aborted,
+	};
+
+	cfg80211_scan_done(req, &info);
+#else
+	cfg80211_scan_done(req, aborted);
+#endif
+}
