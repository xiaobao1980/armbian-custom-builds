+#define SKW_BSS_TYPE_IBSS                             IEEE80211_BSS_TYPE_IBSS
+#define SKW_PRIVACY_ESS_ANY                           IEEE80211_PRIVACY_ANY
+#define SKW_PRIVACY_IBSS_ANY                          IEEE80211_PRIVACY_ANY
