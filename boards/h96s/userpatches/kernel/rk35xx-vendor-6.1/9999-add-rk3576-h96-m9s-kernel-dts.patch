+/* SAI1: I2S audio for HT5010 codec (3.5mm jack).
+ * The HT5010 codec's I2S data line is wired to SAI1 SDO2 ONLY - confirmed from the
+ * vendor Android DTS (sai1 pinctrl muxes lrck/sclk/sdi0/sdo2; no other SDO pin is
+ * muxed). The RK SAI IP resets to routing playback PATH0 -> SDO0, so without a
+ * reroute the stream never reaches the codec and the 3.5mm jack stays silent even
+ * though the sound card registers fine.
+ *
+ * rockchip,sai-tx-route = <0 1 0 3> feeds SDO2 from PATH0 (the array is indexed by
+ * SDO0..SDO3, each value = source PATH; see rockchip_sai_path_config()). It MUST
+ * hold exactly 4 u32 elements: rockchip_sai_path_prepare() counts them with
+ * of_count_phandle_with_args() and returns -EINVAL when num != MAX_LANES(4), which
+ * makes the whole SAI fail to probe ("The property size should be: 4" / "Failed to
+ * prepare TX path: -22") and the 3.5mm card never appears in aplay -l.
+ *
+ * The csc amixer oneshot service repeats this at runtime as a repair path
+ * ('Transmit SDO2 Source Select' = From PATH0) and, importantly, forces
+ * 'Transmit SDOx Select' back to Auto. That control is NOT a pin selector - it is
+ * the TX LANE COUNT (-> sai->tx_lanes), and any value above the channel count makes
+ * ch_per_lane = channels/lanes = 0 -> bclk_rate = 0 -> hw_params dies with
+ * "Mismatch mclk: 12288000, expected 0". Never pin it to SDOx3.
+ *
+ * The lane count is pinned to 1 via rockchip,tdm-tx-lanes = <1>.  This is
+ * safe once rockchip_sai_init_dai() caps playback.channels_max to lanes*2
+ * (see 0001-rockchip-sai-cap-dai-channels-by-tdm-lanes.patch).  Without
+ * that kernel patch, tdm-tx-lanes=<1> makes the vendor kernel mis-compute
+ * bclk (64ch * 1 lane -> bclk overflow).  With the patch, it both fixes the
+ * max channel advertisement and keeps 2ch playback working.
+ */
+&sai1 {
+	status = "okay";
+	rockchip,sai-tx-route = <0 1 0 3>;	/* SDO2 <- PATH0 (playback) */
+	rockchip,tdm-tx-lanes = <1>;		/* force 1 TX lane / stereo max */
+	rockchip,tdm-rx-lanes = <1>;		/* cap capture at 2ch: PW 1.4 probes capture at 64ch -> same mclk overflow */
+	pinctrl-names = "default";
+	pinctrl-0 = <&sai1m0_lrck
+		     &sai1m0_sclk
+		     &sai1m0_sdi0
+		     &sai1m0_sdo2>;
+};
