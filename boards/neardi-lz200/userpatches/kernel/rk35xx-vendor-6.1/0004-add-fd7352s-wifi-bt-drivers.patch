+#define CalRssiVal(RssiInit) (RssiInit & BIT(10) ? ((s16)((u16)(RssiInit>>3) | 0xFF00)) : ((s16)(RssiInit>>3)))
+
+#define SKW_RX_MSDU_LEN(skw, desc) \
+	(test_bit(SKW_FLAG_FW_PN_REUSE, &skw->flags) ? (desc)->pn_reuse.msdu_len : (desc)->msdu.msdu_len)
+
