diff --git a/arch/arm64/boot/dts/rockchip/rk3576-neardi-lz200-wifibt.dtsi b/arch/arm64/boot/dts/rockchip/rk3576-neardi-lz200-wifibt.dtsi
new file mode 100755
index 000000000000..71f8415db91c
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3576-neardi-lz200-wifibt.dtsi
@@ -0,0 +1,60 @@
+
+&{/} {
+    sdio_pwrseq: sdio-pwrseq {
+		compatible = "mmc-pwrseq-simple";
+		pinctrl-names = "default";
+		pinctrl-0 = <&wifi_poweren_gpio>;
+
+		/*
+		 * On the module itself this is one of these (depending
+		 * on the actual card populated):
+		 * - SDIO_RESET_L_WL_REG_ON
+		 * - PDN (power down when low)
+		 */
+		post-power-on-delay-ms = <200>;
+		reset-gpios = <&gpio1 RK_PC6 GPIO_ACTIVE_LOW>;
+		status = "okay";
+	};
+
+    wireless_bluetooth: wireless-bluetooth {
+
+    };
+    /* for seekwave */
+	seekwcn_boot:seekwcn_boot {
+        compatible = "seekwave,sv6160";
+        dma_type = <1>;
+        status = "okay";
+        //skw_iram_path = "/lib/firmware/ROM_EXEC_KERNEL_IRAM.bin";
+        //skw_dram_path = "/lib/firmware/RAM_RW_KERNEL_DRAM.bin";
+        //seekwave_nv_name = "SEEKWAVE_NV_SWT6652.bin";
+    };
+};
+
+&sdio {
+	max-frequency = <200000000>;
+	no-sd;
+	no-mmc;
