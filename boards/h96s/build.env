# H96 Max M9 (RK3576) — 2026-08-29 golden 基线（补丁式 + h96-m9-configure overlay）
# 注意: 板卡配置文件名是 h96-m9.csc, armbian 的 BOARD 必须与文件名一致 → h96-m9。
# 目录名 h96s 只用于区分"golden 基线"这套文件集, 构建产物 board id 与 h96-m9 相同(同一台机器)。
BOARD=h96-m9
BRANCH=vendor
RELEASE=noble
BUILD_DESKTOP=yes
BUILD_MINIMAL=no
# 桌面必须显式指定, 否则 armbian 会弹 dialog 选桌面/档位 (CI 无 TTY 直接挂)
DESKTOP_ENVIRONMENT=gnome
DESKTOP_TIER=mid
# vendor 内核 + GNOME 桌面: 公共扩展
#   rkmpp-mpv / chromium-rkmpp —— 两者互不排斥, 各管一件事 (CI 可覆盖 release/桌面,
#     所以这里都写上, 由扩展按「实际」RELEASE+桌面自己判定是否执行):
#       rkmpp-mpv      → 本地播放: 自编译 mpv/ffmpeg-rockchip (非 jammy；会强制 X11)
#       chromium-rkmpp → 网页视频: PPA 的 chromium +rkmpp (仅 jammy|noble)
#     本板默认 noble + gnome（Wayland 定制版不启用 rkmpp-mpv）→ 只有 chromium 132+rkmpp；
#     用 X11 定制版时两个都生效 = 本地 4K 零拷贝 + 网页硬解 同一镜像。
#   radxa-aic8800   (armbian 官方扩展)                  — AIC8800D80 WiFi DKMS 驱动
#     板上实证(192.168.60.172): SDIO 枚举成功(mmc1:390b SDR104)但内核无 aic8800 驱动
#     (Armbian rk35xx-vendor config 只有 bcmdhd-PCIE, 驱不动 AIC 芯片);
#     AIC8800_TYPE="sdio" 已在 h96-m9.csc 定义。WiFi 驱动起来后 BT UART 才能响应 HCI
#     (combo 芯片固件由 WiFi 驱动加载), h96-m9-bluetooth.service 已加等待时序。
#   rk35xx-chinese-desktop (common/extensions/rk35xx-chinese-desktop.sh)
#     — 中文桌面通用设置: root密码/首启建用户、locale/时区/中文字体、
#       GNOME(Wayland)→ibus-rime+雾凇拼音、Chromium 中文、DTB 过滤。
#       本板 GNOME → 自动走 ibus-rime。
ENABLE_EXTENSIONS=chromium-rkmpp,rkmpp-mpv,radxa-aic8800,rk35xx-chinese-desktop

# Armbian 打镜像时 rsync 默认 --exclude="/home/*"（lib/functions/image/rootfs-to-image.sh:38），
# 会把 default-user 建的家目录丢掉 → 镜像 /home 为空、$HOME 不存在（187 实测）。
# 显式包含 home，家目录与 /etc/skel 才会随镜像交付。
INCLUDE_HOME_DIR=yes
