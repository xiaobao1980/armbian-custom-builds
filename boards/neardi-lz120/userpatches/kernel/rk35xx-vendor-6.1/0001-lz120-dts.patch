+/* RK3568 VOP2 only has vp0/vp1. hdmitx1 takes vp0, hdmitx2 (DSI->LT8912) takes vp1,
+ * so edp2vga must stay off or it fights the DSI path for vp1. Same pairing as Neardi
+ * uses in rk3568-neardi-lpb3568-linux.dts. */
+//#include "rk3568-neardi-lpa3568-edp2vga.dtsi"
+//#include "rk3568-neardi-lpa3568-hdmirx.dtsi"
+#include "rk3568-neardi-lpa3568-wifibt.dtsi"
