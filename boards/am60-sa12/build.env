# AM60 / CVTE SA12 OPS (RK3588) — rockchip-rk3588 家族 vendor 分支
BOARD=am60-sa12
BRANCH=vendor
RELEASE=bookworm
BUILD_DESKTOP=no
BUILD_MINIMAL=no
# vendor 内核: RKMPP+mpv 硬解扩展 (server 镜像同样编译 ffmpeg-rockchip,
# X11/显示管理器部分自动跳过, 供 kiosk/播放场景直接用 mpv 硬解)
#
#   rkmpp-mpv / chromium-rkmpp —— 两者互不排斥, 各管一件事 (CI 可覆盖 release/桌面,
#   所以这里都写上, 由扩展按「实际」RELEASE+桌面自己判定是否执行):
#       rkmpp-mpv     → 本地播放: 自编译 mpv/ffmpeg-rockchip (非 jammy)
#       chromium-rkmpp→ 网页视频: PPA 的 chromium +rkmpp (仅 jammy|noble)
#     本板默认 bookworm + server → rkmpp-mpv 生效(chromium-rkmpp 因 bookworm 自动跳过)。
#
#   ⚠️ bookworm 已知限制: 自带 libplacebo 5.229 < mpv 0.41 硬依赖 6.338.2，
#      自编译 mpv 会在 libplacebo 检查处 exit 1 并中止镜像构建（扩展会在 prepare
#      阶段先打 warn）。IMPORTANT: 需要 mpv 硬解请改 RELEASE=trixie（libplacebo 7.349）
#      或 noble（6.338.2）；
#      只做 CMA/X11 兜底、暂不要硬解栈时设 RKMPP_MPV_SKIP_BUILD=yes。
#
#   rk35xx-chinese-desktop (common/extensions/rk35xx-chinese-desktop.sh)
#     — 中文桌面通用设置。server 镜像下只落 root 密码 / 首启建用户 / locale /
#       时区 / 中文字体；输入法与 Chromium 中文化按 RK_CN_BUILD_DESKTOP=no 自动跳过。
ENABLE_EXTENSIONS=rkmpp-mpv,chromium-rkmpp,rk35xx-chinese-desktop

# Armbian 打镜像时 rsync 默认 --exclude="/home/*"（lib/functions/image/rootfs-to-image.sh:38），
# 会把 default-user 建的家目录丢掉 → 镜像 /home 为空、$HOME 不存在（187 实测）。
# 显式包含 home，家目录与 /etc/skel 才会随镜像交付。
INCLUDE_HOME_DIR=yes
