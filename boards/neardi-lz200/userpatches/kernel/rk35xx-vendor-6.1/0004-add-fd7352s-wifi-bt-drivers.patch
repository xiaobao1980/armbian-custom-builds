+
+	if (nla_type(data) != SKW_ATTR_SET_COUNTRY)
+		skw_warn("attr mismatch, type: %d\n", nla_type(data));
+
+	if (!country || strlen(country) != 2) {
+		skw_err("invalid, country: %s\n", country ? country : "null");
+
+		return -EINVAL;
+	}
+
+	skw_dbg("country: %c%c\n", country[0], country[1]);
