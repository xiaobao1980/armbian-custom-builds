+static inline void skw_wakeup_rx(struct skw_core *skw)
+{
+	int i;
+
+	//wake_up_process(skw->rx_thread);
+	if (skw->hw.bus == SKW_BUS_PCIE) {
+		for (i = 0; i < skw->hw.nr_lmac; i++)
+			if (skw->hw.lmac->iface_bitmap != 0)
+				napi_schedule(&skw->hw.lmac[i].napi_rx);
