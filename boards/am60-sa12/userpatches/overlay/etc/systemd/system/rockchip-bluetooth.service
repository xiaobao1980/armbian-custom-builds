[Unit]
Description=Rockchip AM60 Bluetooth (hciattach ttyS9 / AP6275P)
After=dev-ttyS9.device
Before=bluetooth.service
Wants=bluetooth.service

[Service]
Type=forking
ExecStart=/usr/bin/hciattach -s 115200 /dev/ttyS9 bcm43xx 1500000 flow /lib/firmware/ap6275p/BCM4362A2.hcd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
