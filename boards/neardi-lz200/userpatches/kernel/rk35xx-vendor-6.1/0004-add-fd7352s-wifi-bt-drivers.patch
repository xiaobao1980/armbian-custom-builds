+
+	for (i = 0; i < SKW_MAX_MSG_ID; i++) {
+		if (skw_fw_ver->cmd[i] == 0 || skw_drv_ver.cmd[i] == 0)
+			continue;
+
+		if (skw_drv_ver.cmd[i] != skw_fw_ver->cmd[i]) {
