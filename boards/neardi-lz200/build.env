# Neardi LZ200 (RK3576) — vendor BSP 内核 + rkmpp-mpv X11 硬解栈 (trixie / xfce)
# 注意: 板卡配置文件名是 neardi-lz200.csc, BOARD 必须与文件名一致 → neardi-lz200。
# 板级文件来源: /Users/xiaobao/WorkBuddy/armbian/board/neardi/LKD3576/userpatches/
BOARD=neardi-lz200
BRANCH=vendor
RELEASE=trixie
BUILD_DESKTOP=yes
BUILD_MINIMAL=no
# 桌面必须显式指定, 否则 armbian 会弹 dialog 选桌面/档位 (CI 无 TTY 直接挂)
DESKTOP_ENVIRONMENT=xfce
DESKTOP_TIER=mid
# vendor 内核 + X11(xfce) 桌面: RKMPP+mpv 硬解扩展 (全局非 Wayland)
#   mesa-vpu / rkmpp-mpv —— 两者同时启用, 由扩展内部守卫按「实际」RELEASE+桌面自动二选一
#     (CI 可覆盖 release/desktop_environment, 所以不能在这里写死某一个):
#       GNOME/Wayland + jammy|noble  → mesa-vpu 生效, rkmpp-mpv 让位 (PPA 栈, 零编译)
#       其它(X11/其它发行版/server)  → rkmpp-mpv 生效, mesa-vpu 让位 (自编译栈)
#     本板默认 trixie + xfce → rkmpp-mpv（trixie 不在 mesa-vpu 的 PPA 系列内, 必然走自编译）。
#   rkmpp-mpv  (common/extensions/rkmpp-mpv.sh) — 强制 X11 + 自编译 MPP/RGA/ffmpeg-rockchip + mpv,
#              写入 CMA=512M、udev mpp_service/rga 0666、/etc/mpv/mpv.conf hwdec=rkmpp、桌面菜单(rkmpp-mpv 图标)
# 注: RELEASE 必须 trixie (预编译 deb 钉死 trixie SONAME, 如 libplacebo349); 不能用 bookworm
#   （bookworm 的 libplacebo 5.229 < mpv 0.41 需要的 6.338.2, 自编译必失败）
#   rk35xx-chinese-desktop (common/extensions/rk35xx-chinese-desktop.sh)
#     — 中文桌面通用设置: root密码/首启建用户、locale/时区/中文字体、
#       XFCE(X11)→fcitx5-rime+雾凇拼音、Chromium 中文、DTB 过滤。
#       与 rkmpp-mpv 的“强制 X11”会话一致（xfce 本身就是 X11）。
ENABLE_EXTENSIONS=mesa-vpu,rkmpp-mpv,rk35xx-chinese-desktop
