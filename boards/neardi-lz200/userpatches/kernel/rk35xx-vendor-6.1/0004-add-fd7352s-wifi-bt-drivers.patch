+static int send_data(int portno, char *buffer, int size)
+{
+	struct skw_sdio_data_t *skw_sdio = skw_sdio_get_data();
+	struct sdio_port *port;
+	int ret, count, i;
+	u32 *data = (u32 *)buffer;
+
+	if(size==0)
+		return 0;
