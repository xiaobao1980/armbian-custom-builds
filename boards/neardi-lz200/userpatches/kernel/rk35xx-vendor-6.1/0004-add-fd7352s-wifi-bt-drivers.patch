+static int skw_sched_scan_stop(struct wiphy *wiphy,
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(4, 12, 0)
+			       struct net_device *dev, u64 reqid
+#else
+			       struct net_device *dev
+#endif
+			       SKW_NULL)
+{
+	u64 scan_id = 0;
