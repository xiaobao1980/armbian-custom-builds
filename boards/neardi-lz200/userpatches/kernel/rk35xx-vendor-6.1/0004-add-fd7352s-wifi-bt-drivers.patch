+static inline void skw_reset_ac(struct skw_tx_lmac *txlp)
+{
+	int i;
+
+	for (i = 0; i < SKW_MAX_LMAC_SUPPORT; i++) {
+		txlp->ac_reset = 0xF;
+		txlp++;
+	}
+}
