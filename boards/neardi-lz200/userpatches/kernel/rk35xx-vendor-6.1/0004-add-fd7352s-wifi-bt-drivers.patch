+		SKW_CMD_VER(SKW_CMD_SET_MONITOR_PARAM, V1),
+
+		/* event */
+	};
+
+	skw_fw_ver = SKW_ZALLOC(sizeof(struct skw_version_info), GFP_KERNEL);
+	if (!skw_fw_ver)
+		return -ENOMEM;
+
+	ret = skw_msg_xmit(wiphy, 0, SKW_CMD_SYN_VERSION,
+			   NULL, 0, skw_fw_ver,
+			   sizeof(struct skw_version_info));
+	if (ret) {
+		skw_err("ret: %d\n", ret);
+		SKW_KFREE(skw_fw_ver);
+
+		return ret;
