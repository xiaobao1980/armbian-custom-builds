+
+			if(!strncmp(ucom->pdata->port_name, "LOG", 3))
+				ret = ucom->pdata->hw_sdma_tx(ucom->portno, ucom->tx_buf, 2);
+#endif
+			skw_modem_log_set_assert_status(1);
+		}
+		break;
+		case DEVICE_BSPREADY_EVENT:
