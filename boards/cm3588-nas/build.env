# FriendlyElec CM3588 NAS (RK3588) — vendor BSP 内核 + 无头 NAS 服务端 (trixie)
# 板卡描述文件是本仓导入的上游副本: config/boards/cm3588-nas.csc (BOARD 与文件名一致)
#
# 硬件事实（网口）: 两个 2.5GbE = Realtek **RTL8125B**，挂在 PCIe 上（不是 RK3588 自带 GMAC）。
#   上游正文的 udev 规则按 PCI 地址 0004:41:00.0 命名 eth0，r8125 / r8169 两种驱动都吃；
#   vendor 内核里到底带哪一家、rtl_nic PHY 固件在不在，由
#   post_family_tweaks__cm3588_nas_rtl8125_check 在构建期自检并写进日志。
#
# 硬件事实（风扇）: 板载 4pin 风扇口接 pwm1（pwm1m1_pins），供电 vcc5v0_sys（always-on 5V）。
#   FriendlyElec 的 DTS 把 pwm-fan 节点写成 status = "disabled"，裸镜像里风扇口是死的，
#   而这是 4 盘位封闭机箱 —— 所以本板带 userpatches/kernel/rk35xx-vendor-6.1/
#   0001-cm3588-nas-enable-pwm-fan.patch：打开风扇，并把 rockchip,temp-trips 从
#   50/55/60/65/70 改成 45/50/55/60/65 ℃（对齐 martabal/cm3588-fan、
#   vijaygill/pwm-fan-cm3588 两个社区方案的 45..65 窗口）。
#   ⚠️ 两个取舍，改之前先看补丁抬头：
#     · 有 rockchip,temp-trips 时档位由内核查表（rockchip_system_monitor 通知链），不需要
#       守护进程；代价是不生成 /sys/class/thermal/cooling_deviceN —— 上面那两个守护进程
#       正是写 cooling_device 的，要用它们就得把 temp-trips 删掉，二选一。
#     · 占空比 = cooling-levels/255（vendor 的 0 35 64 100 150 255 ≈ 0/13.7/25/39/59/100%）。
#       最低档停转就抬 cooling-levels[1]，别去挪 temp-trips。
#   落地与否由 post_family_tweaks__cm3588_nas_fan_check 反编译镜像 DTB 自检（跑在
#   dtb-no-mac 之后，看到的就是最终 DTB），只写日志不改镜像。
BOARD=cm3588-nas
BRANCH=vendor
RELEASE=trixie
BUILD_DESKTOP=no
BUILD_MINIMAL=no
# 板级开机定制写在 config/boards/cm3588-nas.csc 的 post_family_tweaks__cm3588_nas_* 里
# （无头设备补 serialcon=ttyFIQ0 串口 + journald 持久化），不要往 customize-image.sh 塞。
#
# 扩展（各扩展自己按 RELEASE/BRANCH/桌面判定，不满足就跳过，写了不多做事）:
#   rkmpp-mpv        —— 装 MPP/RGA/ffmpeg-rockchip 硬解栈。NAS 上不是拿来放桌面视频，
#                       而是给**硬件转码**用（ffmpeg 的 *_rkmpp 解码器 / MPP 编码器）；
#                       顺带写 CMA=512M、udev mpp_service 0666。BUILD_DESKTOP=no 时
#                       显示管理器 / X11 那几步自动跳过。
#                       trixie 有预编译 deb（rkmpp-stack tag -2）→ CI 秒级安装，不自编译。
#   ntp-boot-sync    —— 每次开机强制 NTP 跳步校时。无头设备时间错乱 = TLS 证书校验失败
#                       = 连 apt/letsencrypt 都挂，而且没人看得见。只依赖 systemd+chrony/timesyncd。
#   dtb-no-mac       —— 去掉 vendor DTB 里写死的 MAC，避免同批板子撞 MAC（NAS 多机同网段必踩）。
#   rk35xx-chinese-desktop —— server 镜像下只落 root 密码 / 首启建用户 / locale / 时区 / 中文字体，
#                       输入法与浏览器中文化按 BUILD_DESKTOP=no 自动跳过。
#   audio-friendly-names —— 本板 BUILD_DESKTOP=no → 只装 /usr/local/bin/audio-switch：
#                       写 /etc/asound.conf 切 ALSA 默认出口，卡号按 ID_PATH 关键字探测。
#                       本板 card0 是 hdmiin **纯采集卡（无 PCM）**，ALSA 默认落到它就没声，
#                       所以装机后挑一个出口切一次：sudo audio-switch hdmi（或 3.5 / dp / hdmi1），
#                       audio-switch list 看候选。出厂不预设默认出口（接法决定 HDMI 还是耳机）。
#                       桌面镜像（X11/Wayland workflow）下同一扩展改走 WirePlumber 友好命名。
# 不写 chromium-rkmpp：没有桌面就没有浏览器（X11 定制版 workflow 会自己 add_ext 补上）。
ENABLE_EXTENSIONS=rkmpp-mpv,ntp-boot-sync,dtb-no-mac,rk35xx-chinese-desktop,audio-friendly-names

# Armbian 打镜像时 rsync 默认 --exclude="/home/*"（lib/functions/image/rootfs-to-image.sh:38），
# 会把构建期建好的家目录丢掉 → /home 为空、$HOME 不存在。显式包含 home。
INCLUDE_HOME_DIR=yes
