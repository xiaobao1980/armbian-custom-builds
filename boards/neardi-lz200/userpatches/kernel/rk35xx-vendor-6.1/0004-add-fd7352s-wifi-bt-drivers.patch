+char *skw_strchr(char *str, const char ch)
+{
+    char *ptr = str;
+
+    while((ptr != NULL) && ((*ptr) != '\r') && ((*ptr) != '\n') && ((*ptr) != 0))
+    {
+        if((*ptr) == ch)
+        {
+            return ptr;
+        }
+        ptr ++;
+    }
+    return NULL;
+}
+
+int skw_strlen(char *str)
+{
+    char *ptr = str;
+    int str_len = 0;
+    while((ptr != NULL) && ((*ptr) != '\r') && ((*ptr) != '\n') && ((*ptr) != 0))
+    {
+        ptr ++;
+        str_len ++;
+    }
+    return str_len;
+}
+
+unsigned char skw_char2hex(char ch)
+{
+    unsigned char num = 0;
+    if(ch >= '0' && ch <= '9')
+    {
+        num = ch - 48;//0:48
+    }
+    else if(ch >= 'a' && ch <= 'f')
+    {
+        num = ch + 10 - 97;//a:97
+    }
+    else if(ch >= 'A' && ch <= 'F')
+    {
+        num = ch + 10 - 65;//A:65
+    }
+    return num;
+}
