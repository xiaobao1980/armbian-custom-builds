+struct edma_port edma_ports[MAX_PORT_NUM] = {0};
+static struct platform_device *wifi_data_pdev;
+char firmware_version[128];
+u32 last_sent_wifi_cmd[3];
+u32 port_sta_rec[32] = {0};
+u8 *at_buffer;
+char *bt_rx_buffer[4];
